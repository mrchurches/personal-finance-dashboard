{
  "name": "personal-finance-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"tsx server/index.ts\" \"vite --host 127.0.0.1\"",
    "import": "tsx server/import-cli.ts",
    "import:csv": "tsx server/import-csv-cli.ts",
    "demo": "tsx server/import-csv-cli.ts samples/charges.csv samples/cycles.csv samples/income.csv --database data/demo.sqlite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "demo:snapshot": "tsx scripts/build-demo-snapshot.ts",
    "build:demo": "npm run demo:snapshot && tsc --noEmit && vite build --mode demo"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "antd": "^6.6.1",
    "better-sqlite3": "12.6.2",
    "dayjs": "^1.11.23",
    "express": "^5.1.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.5",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "5.1.1",
    "concurrently": "^9.2.1",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vite": "7.3.1",
    "vitest": "^4.0.15"
  }
}
